# Copy this file to .local/context-panel-runtime.env for local debug installs.
# The real .local/context-panel-runtime.env file is gitignored.

# Use a Google OAuth client for Apple/iOS installed apps. The callback scheme is
# derived as com.googleusercontent.apps.<client-id-prefix> unless overridden.
CONTEXT_PANEL_GOOGLE_OAUTH_CLIENT_ID=
CONTEXT_PANEL_GOOGLE_OAUTH_CLIENT_SECRET=
CONTEXT_PANEL_GOOGLE_OAUTH_CALLBACK_SCHEME=
CONTEXT_PANEL_GOOGLE_OAUTH_LEGACY_CLIENT_ID=
CONTEXT_PANEL_GOOGLE_OAUTH_LEGACY_CLIENT_SECRET=
