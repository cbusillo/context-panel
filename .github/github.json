{
  "defaultBranch": "main",
  "projectType": "native-macos-app",
  "docs": {
    "agentNotes": "AGENTS.md",
    "index": "docs/README.md",
    "productGoals": "docs/product-goals.md",
    "architecture": "docs/architecture.md",
    "designDirection": "docs/design-direction.md",
    "release": "docs/release.md",
    "localLimitProbe": "docs/local-limit-probe.md",
    "providerUsageAccess": "docs/provider-usage-access.md",
    "repoSettings": "docs/repo-settings.md"
  },
  "qualityGate": {
    "build": {
      "default": "swift build"
    },
    "test": {
      "default": "swift test"
    },
    "inspection": {
      "ide": "IntelliJ IDEA",
      "scopePreference": "changed_files"
    },
    "validate": {
      "default": "scripts/commit-gate.sh",
      "cloudKitCompanionSchema": "scripts/validate-cloudkit-companion-schema.sh",
      "companionIOSArchive": "scripts/validate-companion-builds.sh --configuration Release --archive ios",
      "companionVisionOSArchive": "scripts/validate-companion-builds.sh --configuration Release --archive visionos",
      "companionWatchBuild": "scripts/validate-companion-builds.sh --configuration Release watchos",
      "companionTVArchive": "scripts/validate-companion-builds.sh --configuration Release --archive tvos"
    },
    "docsRequiredWhen": [
      "provider behavior changes",
      "provider account model changes",
      "credential storage changes",
      "user-visible UI changes",
      "widget layout changes",
      "release or signing changes",
      "validation gate changes"
    ]
  },
  "importantWorkflows": [
    "CI",
    "CodeQL",
    "Ship",
    "Release",
    "App Store Connect Build Upload",
    "App Store Connect Companion Build Upload",
    "TestFlight Beta Distribution",
    "Submit App Store Review"
  ],
  "branchProtection": {
    "ruleset": {
      "name": "Protect main",
      "target": "defaultBranch",
      "enforcement": "active"
    },
    "pullRequestsRequired": true,
    "requiredStatusChecks": {
      "strict": true,
      "contexts": ["swift", "Analyze Swift"]
    },
    "codeScanning": {
      "tool": "CodeQL",
      "alertsThreshold": "errors",
      "securityAlertsThreshold": "high_or_higher"
    },
    "codeQuality": {
      "severity": "errors"
    },
    "blocksForcePushes": true,
    "blocksDeletion": true
  },
  "qaLabels": [],
  "deployLabels": [],
  "healthUrls": [],
  "runnerPolicy": {
    "pullRequestMacOS": "same-repo: self-hosted macOS ARM64 context-panel; fork: macos-26",
    "routineMacOS": ["self-hosted", "macOS", "ARM64", "context-panel"],
    "releaseMacOS": "macos-26",
    "releaseXcodeMajor": "26",
    "notes": "Use GitHub-hosted macos-26 for fork pull_request validation so untrusted PR code does not run on the persistent self-hosted machine. Use the local self-hosted runner for trusted same-repo pull requests, push/manual routine validation, scheduled CodeQL, and workflow_dispatch events. Namespace persistent mutable build caches by physical checkout path. Keep release/upload jobs on explicit macos-26 until App Store Connect accepts the newer Xcode train."
  },
  "githubSignals": {
    "postMerge": {
      "waitForActions": true,
      "checkSecurityAndQuality": true
    },
    "capabilities": {
      "codeScanning": "available",
      "secretScanning": "available",
      "dependabotAlerts": "available",
      "securityAdvisories": "available"
    },
    "refreshWhen": [
      "repo visibility changes",
      "GitHub plan changes",
      "security settings change",
      "token permissions change"
    ]
  },
  "cleanup": {
    "deleteMergedLocalBranches": true,
    "removeMergedCleanWorktrees": true
  },
  "metadataFreshness": {
    "updateWhen": [
      "validation gates change",
      "important workflows change",
      "repo relationship changes",
      "ownership boundaries change"
    ]
  }
}
