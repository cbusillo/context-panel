{
  "defaultBranch": "main",
  "projectType": "native-macos-app",
  "docs": {
    "agentNotes": "AGENTS.md",
    "index": "docs/README.md",
    "productGoals": "docs/product-goals.md",
    "architecture": "docs/architecture.md",
    "designDirection": "docs/design-direction.md",
    "release": "docs/release.md",
    "signedValidationFingerprints": "docs/signed-validation-fingerprints.md",
    "signedValidationRuntimeReceipts": "docs/signed-validation-runtime-receipts.md",
    "signedValidationOperatorFlow": "docs/signed-validation-operator-flow.md",
    "signedValidationGalleries": "docs/signed-validation-galleries.md",
    "localLimitProbe": "docs/local-limit-probe.md",
    "providerUsageAccess": "docs/provider-usage-access.md",
    "repoSettings": "docs/repo-settings.md"
  },
  "qualityGate": {
    "build": {
      "default": "swift build"
    },
    "test": {
      "default": "swift test"
    },
    "inspection": {
      "ide": "IntelliJ IDEA",
      "scopePreference": "changed_files"
    },
    "validate": {
      "default": "scripts/commit-gate.sh",
      "cloudKitCompanionSchema": "scripts/validate-cloudkit-companion-schema.sh",
      "companionIOSArchive": "scripts/validate-companion-builds.sh --configuration Release --archive ios",
      "companionVisionOSArchive": "scripts/validate-companion-builds.sh --configuration Release --archive visionos",
      "companionWatchBuild": "scripts/validate-companion-builds.sh --configuration Release watchos",
      "companionTVArchive": "scripts/validate-companion-builds.sh --configuration Release --archive tvos",
      "signedValidationCoordinator": "scripts/context-panel-validation.py start-session --version <version> --build-number <build-number>",
      "signedValidationCoordinatorStatus": "scripts/context-panel-validation.py status --version <version> --build-number <build-number>",
      "signedValidationFinalReport": "scripts/context-panel-validation.py final-report --version <version> --build-number <build-number>",
      "appStoreReviewValidationPreflight": "scripts/submit-app-store-review.py --platform <platform> --version <version> --build-number <build-number> --validation-report <final-report.json> --validate-report-only",
      "signedValidationRuntimeEvidence": "scripts/context-panel-validation.py sync-runtime-evidence --version <version> --build-number <build-number>",
      "signedValidationCoordinatorTests": "python3 -m unittest Tests/ScriptsTests/test_validation_coordinator.py Tests/ScriptsTests/test_runtime_receipt_ingestion.py Tests/ScriptsTests/test_validation_operator_flow.py Tests/ScriptsTests/test_release_workflows.py",
      "signedValidationOperatorFlowTests": "python3 -m unittest Tests/ScriptsTests/test_validation_operator_flow.py",
      "signedValidationGalleryTests": "swift test --filter 'ContextPanelCoreTests.validation' && python3 -m unittest Tests/ScriptsTests/test_validation_gallery_target_graph.py",
      "runtimeReceiptSession": "scripts/context-panel-runtime-session.py status",
      "runtimeReceiptTests": "swift test --filter 'ContextPanelCoreTests.runtime|ContextPanelCoreTests.snapshotRefreshEvidence' && uv run python -m unittest Tests.ScriptsTests.test_runtime_receipts Tests.ScriptsTests.test_runtime_session",
      "surfaceFingerprintContract": "scripts/context-panel-surface-manifest.py validate",
      "surfaceEvidenceComparison": "scripts/context-panel-surface-manifest.py compare --previous <previous-source-manifest.json> --current <current-source-manifest.json> --train <beta|rc|release>",
      "surfaceFingerprintTests": "python3 -m unittest Tests/ScriptsTests/test_surface_manifest.py"
    },
    "docsRequiredWhen": [
      "provider behavior changes",
      "provider account model changes",
      "credential storage changes",
      "user-visible UI changes",
      "widget layout changes",
      "release or signing changes",
      "validation gate changes"
    ]
  },
  "importantWorkflows": [
    "CI",
    "CodeQL",
    "Ship",
    "Release",
    "App Store Connect Build Upload",
    "App Store Connect Companion Build Upload",
    "TestFlight Beta Distribution",
    "Submit App Store Review"
  ],
  "branchProtection": {
    "ruleset": {
      "name": "Protect main",
      "target": "defaultBranch",
      "enforcement": "active"
    },
    "pullRequestsRequired": true,
    "requiredStatusChecks": {
      "strict": true,
      "contexts": ["swift", "Analyze Swift"]
    },
    "codeScanning": {
      "tool": "CodeQL",
      "alertsThreshold": "errors",
      "securityAlertsThreshold": "high_or_higher"
    },
    "codeQuality": {
      "severity": "errors"
    },
    "blocksForcePushes": true,
    "blocksDeletion": true
  },
  "qaLabels": [],
  "deployLabels": [],
  "healthUrls": [],
  "runnerPolicy": {
    "pullRequestMacOS": "same-repo: self-hosted macOS ARM64 context-panel; fork: macos-26",
    "routineMacOS": ["self-hosted", "macOS", "ARM64", "context-panel"],
    "releaseMacOS": "macos-26",
    "releaseXcodeMajor": "26",
    "notes": "Use GitHub-hosted macos-26 for fork pull_request validation so untrusted PR code does not run on the persistent self-hosted machine. Use the local self-hosted runner for trusted same-repo pull requests, push/manual routine validation, scheduled CodeQL, and workflow_dispatch events. Namespace persistent mutable build caches by physical checkout path. Keep release/upload jobs on explicit macos-26 until App Store Connect accepts the newer Xcode train."
  },
  "githubSignals": {
    "postMerge": {
      "waitForActions": true,
      "checkSecurityAndQuality": true
    },
    "capabilities": {
      "codeScanning": "available",
      "secretScanning": "available",
      "dependabotAlerts": "available",
      "securityAdvisories": "available"
    },
    "refreshWhen": [
      "repo visibility changes",
      "GitHub plan changes",
      "security settings change",
      "token permissions change"
    ]
  },
  "cleanup": {
    "deleteMergedLocalBranches": true,
    "removeMergedCleanWorktrees": true
  },
  "metadataFreshness": {
    "updateWhen": [
      "validation gates change",
      "important workflows change",
      "repo relationship changes",
      "ownership boundaries change"
    ]
  }
}
