{
  "defaultBranch": "main",
  "projectType": "native-macos-app",
  "docs": {
    "agentNotes": "AGENTS.md",
    "codeqlCancellationCleanup": "docs/repo-settings.md",
    "overallDirection": "https://github.com/cbusillo/direction/blob/HEAD/DIRECTION.md",
    "index": "docs/README.md",
    "productGoals": "docs/product-goals.md",
    "architecture": "docs/architecture.md",
    "designDirection": "docs/design-direction.md",
    "release": "docs/release.md",
    "validationAuthority": "docs/validation-authority.md",
    "signedValidationFingerprints": "docs/signed-validation-fingerprints.md",
    "signedValidationRuntimeReceipts": "docs/signed-validation-runtime-receipts.md",
    "signedValidationOperatorFlow": "docs/signed-validation-operator-flow.md",
    "signedValidationGalleries": "docs/signed-validation-galleries.md",
    "signedValidationReplayInventory": "docs/signed-validation-replay-inventory.md",
    "testLanes": "docs/test-lanes.md",
    "localLimitProbe": "docs/local-limit-probe.md",
    "providerUsageAccess": "docs/provider-usage-access.md",
    "multiAccountSetup": "docs/provider-usage-access.md#multiple-local-account-entries",
    "codexSessionQuota": "docs/provider-usage-access.md#per-account-codex-session-quota",
    "currentCodexHomes": "docs/provider-usage-access.md#current-codex-homes-and-openai-recovery",
    "agentAccountSnapshot": "docs/provider-usage-access.md#agent-readable-account-snapshot",
    "repoSettings": "docs/repo-settings.md",
    "sharedAccountIdentity": "docs/shared-account-identity.md"
  },
  "qualityGate": {
    "build": {
      "default": "swift build",
      "macOSReleaseCI": ".github/workflows/ci.yml macos-release (Ship hosted runner and Xcode guard; optimized universal native app build; required swift check joins release compilation and product tests)"
    },
    "test": {
      "default": "swift test",
      "lanesManifest": "Config/ContextPanelTestLanes.json",
      "lanesValidate": "uv run --no-project python scripts/context-panel-test-lanes.py validate",
      "fastPython": "uv run --no-project python scripts/context-panel-test-lanes.py run --lane fast-local-python",
      "routinePython": "uv run --no-project --with cryptography python scripts/context-panel-test-lanes.py run --lane routine-ci-python",
      "routineSwift": "uv run --no-project python scripts/context-panel-test-lanes.py time-command --lane routine-ci-swift -- swift test",
      "pythonWorkers": "Config/ContextPanelTestLanes.json workersByFile (pytest-xdist via uv for independent unittest fixtures; --serial uses standard unittest; docs/test-lanes.md)"
    },
    "inspection": {
      "ide": "PyCharm",
      "scopePreference": "changed_files",
      "prepare": {
        "python": {
          "version": "3.13",
          "moduleName": "context-panel",
          "testRoots": ["Tests"],
          "sync": false,
          "requiredGeneratedState": [".venv", ".idea"]
        }
      }
    },
    "validate": {
      "default": "scripts/commit-gate.sh",
      "releaseApprovalPolicy": "uv run scripts/check-release-approvals.py (classified-graph structural dry-run: one secretless Ship approval; standalone gates; same-commit local channels inherit repository secrets; one release secret environment; live review-metadata check; owner role move and RELEASE_APPROVALS_CONFIGURED=true required); unclassified environment selectors must prove disjointness from reserved release names, with literal and fixed-namespace lookup routes; unclassified reusable calls remain accepted and report incomplete coverage (docs/release.md)",
      "ciChangeScope": "uv run --no-project python scripts/ci-change-scope.py --base <base-sha> (pull requests only; skips swift build, swift test, universal macOS Release compilation, and the companion builds when every changed path is documentation or validation tooling; unknown paths run everything; pushes to main and CodeQL always run in full)",
      "companionUploadFixtureTools": "CONTEXT_PANEL_UPLOAD_FIXTURE_TOOLS_DIR=<dir> scripts/upload-app-store-connect-companion-app.sh --export-only <other arguments> (test-only seam for fixture xcodebuild and codesign; refused for uploads)",
      "cloudKitCompanionSchema": "scripts/validate-cloudkit-companion-schema.sh",
      "cloudKitSchemaReceiptGate": "scripts/require-cloudkit-schema-receipt.sh (called by every live release entrypoint; local live runs use scripts/with-cloudkit-schema-receipt.sh -- <command>)",
      "githubReleasePublication": "scripts/publish-github-release.py --validate-only <release arguments> (non-mutating package eligibility check; live draft lookup uses gh release view plus REST-by-ID; publication policy and validation-artifact route: docs/release.md#ci-signing-and-notarization-secrets)",
      "cloudKitProductionSchemaReceipt": "scripts/with-cloudkit-schema-receipt.sh -- <live-release-command> (validates the Production receipt or issues a fresh exact-source receipt; standalone issuance and runtime-evidence relay: docs/release.md#cloudkit-production-schema-gate)",
      "companionIOSArchive": "scripts/validate-companion-builds.sh --configuration Release --archive ios",
      "companionVisionOSArchive": "scripts/validate-companion-builds.sh --configuration Release --archive visionos",
      "companionWatchBuild": "scripts/validate-companion-builds.sh --configuration Release watchos",
      "companionTVArchive": "scripts/validate-companion-builds.sh --configuration Release --archive tvos",
      "validationGalleryIsolation": "scripts/check-validation-gallery-isolation.sh --products-root <derived-data>/Build/Products (run by validate-companion-builds.sh after every build or archive)",
      "companionCachePreflight": "scripts/context-panel-companion-cache.sh preflight",
      "companionCacheQuarantine": "scripts/context-panel-companion-cache.sh quarantine --root <absolute-.build-or-derived-data/companion-build-validation-root>",
      "companionCacheRetention": "scripts/context-panel-companion-cache.sh prune --root <absolute-.build-or-derived-data/companion-build-validation-root> [--older-than-days N] [--apply] (default: preview unsigned quarantine entries older than seven days; apply is explicit)",
      "companionCacheRetentionTests": "uv run --no-project python -m unittest Tests.ScriptsTests.test_companion_quarantine_retention",
      "signedValidationCoordinator": "scripts/context-panel-validation.py start-session --version <version> --build-number <build-number>",
      "signedValidationSharedViewPlan": "scripts/context-panel-validation.py plan-shared-view-evidence --surface-comparison <comparison.json> [--base-requirements <placement-requirements.json>] --output <visual-review-requirements.json>",
      "signedValidationSharedViewCapture": "scripts/context-panel-validation.py capture-shared-view-evidence --surface-comparison <comparison.json> --current-manifest <current-surface-manifest.json> --requirements <visual-review-requirements.json> --capture-config <private-capture-config.json> --artifact-root <absolute-private-artifact-root> --output <absolute-shared-view-capture-receipt.json>",
      "signedValidationHostedSharedViewCapture": "Shared-View Capture Evidence workflow: manually dispatch with exact previous/current source commits, version/build identities, and macOS/iOS/visionOS/tvOS previous/current artifact run IDs; iOS/iPadOS/visionOS use an app-associated non-shipping XCUITest shared-view renderer, and the workflow emits shared-view-only public evidence plus short-retention PNGs, including private invalid-attachment diagnostics on failed capture.",
      "signedValidationVisualSession": "scripts/context-panel-validation.py start-session --version <version> --build-number <build-number> --surface-comparison <comparison.json> --visual-review-requirements <visual-review-requirements.json> --expected-build-manifest <ExpectedBuildManifest-platform.json>",
      "signedValidationCoordinatorStatus": "scripts/context-panel-validation.py status --version <version> --build-number <build-number>",
      "signedValidationFinalReport": "scripts/context-panel-validation.py final-report --version <version> --build-number <build-number>",
      "signedValidationRecordVisualReview": "scripts/context-panel-validation.py record-visual-review --version <version> --build-number <build-number> --requirement-id <requirement-id> --decision <approved|rejected>",
      "signedValidationExportVisualReviews": "scripts/context-panel-validation.py export-visual-reviews --version <version> --build-number <build-number> --json",
      "appStoreReviewValidationPreflight": "scripts/submit-app-store-review.py --platform <platform> --version <version> --build-number <build-number> --validation-report <final-report.json> --validation-train release --release-evidence-report <release-evidence.json> --release-evidence-mode enforce --release-evidence-comparison <comparison.json> --release-evidence-expected-build-manifest <ExpectedBuildManifest-platform.json> --release-evidence-selected-rc-ledger <approved-rc-lineage.json> --release-evidence-shadow-evidence <shadow-evidence.json> [--release-evidence-historical-policy-archive <policy-archive.json>] --validate-report-only",
      "signedValidationRuntimeEvidence": "scripts/context-panel-validation.py sync-runtime-evidence --version <version> --build-number <build-number> --cloudkit-schema-receipt <cloudkit-production-schema-receipt.json>",
      "signedValidationAutomationAdvance": "scripts/context-panel-validation.py advance-automation --version <version> --build-number <build-number> --cloudkit-schema-receipt <cloudkit-production-schema-receipt.json> [--surface-comparison <comparison.json> --current-manifest <current-surface-manifest.json> --requirements <visual-review-requirements.json> --capture-config <private-capture-config.json> --artifact-root <absolute-private-artifact-root> --capture-output <absolute-shared-view-capture-receipt.json>]",
      "signedValidationAutomationTests": "uv run --no-project python -m unittest Tests/ScriptsTests/test_validation_automation.py Tests/ScriptsTests/test_validation_operator_flow.py",
      "signedValidationCoordinatorTests": "uv run --no-project python -m unittest Tests/ScriptsTests/test_validation_coordinator.py Tests/ScriptsTests/test_validation_automation.py Tests/ScriptsTests/test_runtime_receipt_ingestion.py Tests/ScriptsTests/test_validation_operator_flow.py Tests/ScriptsTests/test_visual_approvals.py Tests/ScriptsTests/test_release_workflows.py",
      "signedValidationSharedViewEvidenceTests": "uv run --no-project python -m unittest Tests/ScriptsTests/test_shared_view_evidence.py",
      "signedValidationSharedViewCaptureTests": "uv run --no-project python -m unittest Tests/ScriptsTests/test_shared_view_capture.py Tests/ScriptsTests/test_shared_view_capture_workflow.py",
      "signedValidationOperatorFlowTests": "uv run --no-project python -m unittest Tests/ScriptsTests/test_validation_operator_flow.py",
      "signedValidationVisualApprovalTests": "uv run --no-project python -m unittest Tests/ScriptsTests/test_visual_approvals.py Tests/ScriptsTests/test_validation_operator_flow.py",
      "signedValidationGalleryTests": "swift test --filter 'ValidationGallery|ValidationFixtures|validationGallery|validationFixture' && uv run --no-project python -m unittest Tests/ScriptsTests/test_validation_gallery_target_graph.py",
      "signedValidationReplayInventoryCheck": "scripts/context-panel-replay-inventory.py check --json",
      "physicalDefectCorpusCheck": "uv run --no-project python scripts/context-panel-defect-corpus.py check --json",
      "signedValidationReplayInventorySeal": "scripts/context-panel-replay-inventory.py seal --root shadow-trains=<absolute-shadow-trains-root> --root build-release-evidence=<absolute-release-evidence-root> --root code-evidence=<absolute-code-evidence-root> --json",
      "signedValidationReplayInventoryVerify": "scripts/context-panel-replay-inventory.py verify --root shadow-trains=<absolute-shadow-trains-root> --root build-release-evidence=<absolute-release-evidence-root> --root code-evidence=<absolute-code-evidence-root> --json",
      "signedValidationTrainReplayCheck": "uv run --no-project python scripts/context-panel-signed-train-replay.py check --json",
      "signedValidationTrainReplayVerify": "uv run --no-project python scripts/context-panel-signed-train-replay.py verify --root shadow-trains=<absolute-shadow-trains-root> --root build-release-evidence=<absolute-release-evidence-root> --root code-evidence=<absolute-code-evidence-root> --json",
      "signedValidationReplayInventoryTests": "uv run --no-project python -m unittest Tests/ScriptsTests/test_replay_inventory.py",
      "physicalDefectCorpusTests": "uv run --no-project python -m unittest Tests/ScriptsTests/test_physical_defect_corpus.py",
      "runtimeReceiptSession": "scripts/context-panel-runtime-session.py status",
      "runtimeReceiptTests": "swift test --filter 'ContextPanelCoreTests.runtime|ContextPanelCoreTests.snapshotRefreshEvidence' && uv run --no-project python -m unittest Tests.ScriptsTests.test_runtime_receipts Tests.ScriptsTests.test_runtime_session",
      "surfaceFingerprintContract": "scripts/context-panel-surface-manifest.py validate",
      "surfaceEvidenceComparison": "scripts/context-panel-surface-manifest.py compare --previous <previous-source-manifest.json> --current <current-source-manifest.json> --train <beta|rc|release> --previous-expected-build-manifest <previous-platform.json>... --current-expected-build-manifest <current-platform.json>...",
      "surfaceFingerprintTests": "uv run --no-project python -m unittest Tests/ScriptsTests/test_surface_manifest.py",
      "releaseEvidenceBetaShadowGate": "scripts/context-panel-release-gate.py shadow --train beta --comparison <comparison.json> --validation-report <final-report.json> --expected-build-manifest <ExpectedBuildManifest-platform.json> --policy Config/ContextPanelReleaseEvidencePolicy.json --surface-policy Config/ContextPanelSurfacePolicy.json [--historical-policy-archive <policy-archive.json>] --output <release-evidence.json> --lineage-output <release-evidence-lineage.json>",
      "releaseEvidenceRCShadowGate": "scripts/context-panel-release-gate.py shadow --train rc --comparison <comparison.json> --validation-report <final-report.json> --expected-build-manifest <ExpectedBuildManifest-platform.json> --policy Config/ContextPanelReleaseEvidencePolicy.json --surface-policy Config/ContextPanelSurfacePolicy.json [--historical-policy-archive <policy-archive.json>] --output <release-evidence.json> --lineage-output <release-evidence-lineage.json>",
      "releaseEvidenceReleaseShadowGate": "scripts/context-panel-release-gate.py shadow --train release --comparison <comparison.json> --validation-report <final-report.json> --expected-build-manifest <ExpectedBuildManifest-platform.json> --policy Config/ContextPanelReleaseEvidencePolicy.json --surface-policy Config/ContextPanelSurfacePolicy.json [--historical-policy-archive <policy-archive.json>] --selected-rc-ledger <approved-rc-lineage.json> --output <release-evidence.json> --lineage-output <release-evidence-lineage.json>",
      "releaseEvidenceBetaEnforcementGate": "scripts/context-panel-release-gate.py enforce --train beta --comparison <comparison.json> --validation-report <final-report.json> --expected-build-manifest <ExpectedBuildManifest-platform.json> --policy Config/ContextPanelReleaseEvidencePolicy.json --surface-policy Config/ContextPanelSurfacePolicy.json [--historical-policy-archive <policy-archive.json>] --shadow-evidence <shadow-evidence.json> --output <release-evidence.json> --lineage-output <release-evidence-lineage.json>",
      "releaseEvidenceRCEnforcementGate": "scripts/context-panel-release-gate.py enforce --train rc --comparison <comparison.json> --validation-report <final-report.json> --expected-build-manifest <ExpectedBuildManifest-platform.json> --policy Config/ContextPanelReleaseEvidencePolicy.json --surface-policy Config/ContextPanelSurfacePolicy.json [--historical-policy-archive <policy-archive.json>] --shadow-evidence <shadow-evidence.json> --output <release-evidence.json> --lineage-output <release-evidence-lineage.json>",
      "releaseEvidenceReleaseEnforcementGate": "scripts/context-panel-release-gate.py enforce --train release --comparison <comparison.json> --validation-report <final-report.json> --expected-build-manifest <ExpectedBuildManifest-platform.json> --policy Config/ContextPanelReleaseEvidencePolicy.json --surface-policy Config/ContextPanelSurfacePolicy.json [--historical-policy-archive <policy-archive.json>] --selected-rc-ledger <approved-rc-lineage.json> --shadow-evidence <shadow-evidence.json> --output <release-evidence.json> --lineage-output <release-evidence-lineage.json>",
      "releaseEvidenceBetaRCReportValidation": "scripts/validate-release-evidence-report.py --report <release-evidence.json> --validation-report <final-report.json> --comparison <comparison.json> --expected-build-manifest <ExpectedBuildManifest-platform.json> --policy Config/ContextPanelReleaseEvidencePolicy.json --surface-policy Config/ContextPanelSurfacePolicy.json [--historical-policy-archive <policy-archive.json>] --version <version> --build-number <build-number> --train <beta|rc>",
      "releaseEvidenceReleaseShadowReportValidation": "scripts/validate-release-evidence-report.py --report <release-evidence.json> --validation-report <final-report.json> --comparison <comparison.json> --expected-build-manifest <ExpectedBuildManifest-platform.json> --policy Config/ContextPanelReleaseEvidencePolicy.json --surface-policy Config/ContextPanelSurfacePolicy.json [--historical-policy-archive <policy-archive.json>] --selected-rc-ledger <approved-rc-lineage.json> --version <version> --build-number <build-number> --train release",
      "releaseEvidenceEnforcedReportValidation": "scripts/validate-release-evidence-report.py --report <release-evidence.json> --validation-report <final-report.json> --comparison <comparison.json> --expected-build-manifest <ExpectedBuildManifest-platform.json> --policy Config/ContextPanelReleaseEvidencePolicy.json --surface-policy Config/ContextPanelSurfacePolicy.json [--historical-policy-archive <policy-archive.json>] --shadow-evidence <shadow-evidence.json> --version <version> --build-number <build-number> --train <beta|rc> --enforce",
      "releaseEvidenceReleaseReportValidation": "scripts/validate-release-evidence-report.py --report <release-evidence.json> --validation-report <final-report.json> --comparison <comparison.json> --expected-build-manifest <ExpectedBuildManifest-platform.json> --policy Config/ContextPanelReleaseEvidencePolicy.json --surface-policy Config/ContextPanelSurfacePolicy.json [--historical-policy-archive <policy-archive.json>] --selected-rc-ledger <approved-rc-lineage.json> --shadow-evidence <shadow-evidence.json> --version <version> --build-number <build-number> --train release --enforce",
      "appStoreReviewReleaseEvidenceDefault": "enforce",
      "releaseEvidenceTests": "uv run --no-project python -m unittest Tests/ScriptsTests/test_release_evidence_gate.py Tests/ScriptsTests/test_submit_app_store_review.py Tests/ScriptsTests/test_release_workflows.py",
      "codexClientCompatibility": "swift test --filter \"(?i)(codex|accountConfiguration|promptCache|defaultAccount|legacyConfiguration|retired|settingsAccounts)\""
    },
    "docsRequiredWhen": [
      "provider behavior changes",
      "provider account model changes",
      "credential storage changes",
      "user-visible UI changes",
      "widget layout changes",
      "release or signing changes",
      "validation gate changes"
    ]
  },
  "importantWorkflows": [
    "CI",
    "CodeQL",
    "Ship",
    "Release",
    "App Store Connect Build Upload",
    "App Store Connect Companion Build Upload",
    "Shared-View Capture Evidence",
    "TestFlight Beta Distribution",
    "Submit App Store Review",
    "Upload App Store Screenshots"
  ],
  "qaLabels": [],
  "deployLabels": [],
  "healthUrls": [],
  "githubSignals": {
    "postMerge": {
      "waitForActions": true,
      "checkSecurityAndQuality": true
    },
    "capabilities": {
      "codeScanning": "available",
      "secretScanning": "available",
      "dependabotAlerts": "available",
      "securityAdvisories": "available"
    },
    "refreshWhen": [
      "repo visibility changes",
      "GitHub plan changes",
      "security settings change",
      "token permissions change"
    ]
  },
  "cleanup": {
    "deleteMergedLocalBranches": true,
    "removeMergedCleanWorktrees": true
  },
  "metadataFreshness": {
    "updateWhen": [
      "validation gates change",
      "important workflows change",
      "repo relationship changes",
      "ownership boundaries change",
      "default-branch rulesets or required status checks change",
      "merge or release routing changes",
      "catalog metadata schema or overall direction changes"
    ]
  },
  "githubSettings": {
    "expected": {
      "deleteBranchOnMerge": true
    }
  },
  "prWorkflow": {
    "mergeMethod": "merge",
    "watchSkill": "babysit-pr"
  }
}
