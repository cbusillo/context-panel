        "Config/ContextPanelRefreshAgentAppStore.entitlements"
      ]
    },
    "config-companion-app": {
      "include": [
        "Config/ContextPanelCompanion-Info.plist",
        "Config/ContextPanelCompanion.entitlements"
      ]
    },
    "config-companion-widget": {
      "include": [
        "Config/ContextPanelCompanionWidget-Info.plist",
        "Config/ContextPanelCompanionWidget.entitlements",
        "Config/ContextPanelCompanionWidgetAppStore.entitlements"
      ]
    },
    "config-watch-app": {
      "include": [
        "Config/ContextPanelWatch-Info.plist",
        "Config/ContextPanelWatch.entitlements",
        "Config/ContextPanelWatchAppStore.entitlements"
      ]
