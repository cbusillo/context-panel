{
  "schemaVersion": 1,
  "algorithm": "sha256",
  "digestDomain": "context-panel-surface/v1",
  "project": {
    "path": "project.yml",
    "reader": "scripts/context-panel-project-spec-json.rb"
  },
  "archiveLayouts": {
    "macos": {
      "macos.app": "Products/Applications/Context Panel.app",
      "macos.widget": "Products/Applications/Context Panel.app/Contents/PlugIns/ContextPanelWidgetExtension.appex",
      "macos.refresh-agent": "Products/Applications/Context Panel.app/Contents/Library/LoginItems/ContextPanelRefreshAgent.app"
    },
    "ios": {
      "companion.ios.app": "Products/Applications/Context Panel.app",
      "companion.ios.widget": "Products/Applications/Context Panel.app/PlugIns/ContextPanelCompanionWidgetExtension.appex",
      "watchos.app": "Products/Applications/Context Panel.app/Watch/Context Panel.app",
      "watchos.widget": "Products/Applications/Context Panel.app/Watch/Context Panel.app/PlugIns/ContextPanelWatchWidgetExtension.appex"
    },
    "visionos": {
      "companion.visionos.app": "Products/Applications/Context Panel.app",
      "companion.visionos.widget": "Products/Applications/Context Panel.app/PlugIns/ContextPanelCompanionWidgetExtension.appex"
    },
    "tvos": {
      "tvos.app": "Products/Applications/Context Panel.app",
      "tvos.top-shelf": "Products/Applications/Context Panel.app/PlugIns/ContextPanelTVTopShelfExtension.appex"
    }
  },
  "toolchain": {
    "swiftLanguageVersion": "6.0",
    "releaseXcodeMajor": "26"
  },
  "evidencePolicy": {
    "classes": ["shared-view", "actual-runtime", "os-composited-placement"],
    "trainMinimumEvidence": {
      "beta": ["shared-view"],
      "rc": ["shared-view", "actual-runtime"],
      "release": ["shared-view", "actual-runtime"]
    },
    "changeRequirements": {
      "render": ["shared-view", "actual-runtime", "os-composited-placement"],
      "runtime": ["actual-runtime"],
      "unknown": ["shared-view", "actual-runtime", "os-composited-placement"],
      "placement": ["actual-runtime", "os-composited-placement"]
    },
    "releaseRequiresApprovedRCTarget": true
  },
  "inventory": {
    "governedPatterns": [
      "Sources/**/*.swift",
      "Config/*.plist",
      "Config/*.entitlements",
      "CloudKit/**/*.json",
      "Resources/Assets.xcassets/**/*",
      "Resources/TVAssets.xcassets/**/*",
      "Package.swift",
      "Config/ContextPanelSurfacePolicy.json",
      "scripts/context-panel-build-fingerprint.sh",
      "scripts/context-panel-project-spec-json.rb",
      "scripts/context-panel-surface-manifest.py",
      "scripts/stamp-context-panel-build.sh",
      "scripts/context-panel-write-expected-build.sh",
      "scripts/context_panel_surface_manifest/**/*.py"
    ],
    "excludedBasenames": [".DS_Store"],
    "ignoredInputs": [
      {
        "pattern": "Sources/CodexRateLimitProbe/**/*.swift",
        "reason": "Developer-only SwiftPM probe; no shipping Xcode target compiles it."
      },
      {
        "pattern": "Sources/OpenAILimitProbe/**/*.swift",
        "reason": "Developer-only SwiftPM probe; no shipping Xcode target compiles it."
      },
      {
        "pattern": "Sources/PromptCacheTelemetryMirror/**/*.swift",
        "reason": "Developer-only SwiftPM utility; shipping products use the shared core service."
      },
      {
        "pattern": "Sources/PromptCacheTelemetryProbe/**/*.swift",
        "reason": "Developer-only SwiftPM probe; no shipping Xcode target compiles it."
      },
      {
        "pattern": "Sources/SnapshotStoreProbe/**/*.swift",
        "reason": "Developer-only SwiftPM probe; no shipping Xcode target compiles it."
      },
      {
        "pattern": "Package.swift",
        "reason": "SwiftPM development and test graph; shipping artifacts are defined by project.yml."
      }
    ]
  },
  "inputGroups": {
    "surface-tooling": {
      "include": [
        "Config/ContextPanelSurfacePolicy.json",
        "scripts/context-panel-build-fingerprint.sh",
        "scripts/context-panel-project-spec-json.rb",
        "scripts/context-panel-surface-manifest.py",
        "scripts/stamp-context-panel-build.sh",
        "scripts/context-panel-write-expected-build.sh",
        "scripts/context_panel_surface_manifest/**/*.py"
      ]
    },
    "core": {
      "include": ["Sources/ContextPanelCore/**/*.swift"]
    },
    "cloudkit-sync": {
      "include": ["Sources/ContextPanelCloudKitSync/**/*.swift"],
      "forbidPresentationImports": true
    },
    "cloudkit-contract": {
      "include": ["CloudKit/**/*.json"]
    },
    "widget-ui": {
      "include": ["Sources/ContextPanelWidgetUI/**/*.swift"]
    },
    "validation-fixtures": {
      "include": ["Sources/ContextPanelValidationFixtures/**/*.swift"]
    },
    "validation-gallery-ui": {
      "include": ["Sources/ContextPanelValidationGalleryUI/**/*.swift"]
    },
    "settings-ui": {
      "include": ["Sources/ContextPanelSettingsUI/**/*.swift"]
    },
    "mac-app": {
      "include": ["Sources/ContextPanelApp/**/*.swift"]
    },
    "mac-widget": {
      "include": ["Sources/ContextPanelWidget/**/*.swift"]
    },
    "refresh-agent": {
      "include": ["Sources/ContextPanelRefreshAgent/**/*.swift"]
    },
    "companion-app": {
