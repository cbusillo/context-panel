    "config-watch-widget": {
      "include": [
        "Config/ContextPanelWatchWidget-Info.plist",
        "Config/ContextPanelWatchWidget.entitlements",
        "Config/ContextPanelWatchWidgetAppStore.entitlements"
      ]
    },
    "config-tv-app": {
      "include": [
        "Config/ContextPanelTV-Info.plist",
        "Config/ContextPanelTV.entitlements"
      ]
    },
    "config-tv-top-shelf": {
      "include": [
        "Config/ContextPanelTVTopShelf-Info.plist",
        "Config/ContextPanelTVTopShelf.entitlements"
      ]
    },
    "placement-macos-widget": {
      "include": [
        "Config/ContextPanelWidget-Info.plist",
        "Sources/ContextPanelApp/ContextPanelApp.swift"
      ]
    },
    "placement-companion-widget": {
      "include": [
        "Config/ContextPanelCompanionWidget-Info.plist",
        "Sources/ContextPanelCompanion/ContextPanelCompanionApp.swift"
      ]
    },
    "placement-watch-widget": {
      "include": [
