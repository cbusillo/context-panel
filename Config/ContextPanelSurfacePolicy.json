    },
    "watch-app": {
      "include": ["Sources/ContextPanelWatch/**/*.swift"]
    },
    "watch-support-app": {
      "include": ["Sources/ContextPanelWatchSupport/**/*.swift"]
    },
    "watch-support-widget": {
      "include": ["Sources/ContextPanelWatchSupport/**/*.swift"],
      "exclude": [
        "Sources/ContextPanelWatchSupport/WatchSyncPresentation.swift"
      ]
    },
    "watch-widget": {
      "include": ["Sources/ContextPanelWatchWidget/**/*.swift"]
    },
    "tv-app": {
      "include": ["Sources/ContextPanelTV/**/*.swift"]
    },
    "tv-support": {
      "include": ["Sources/ContextPanelTVSupport/**/*.swift"]
    },
    "tv-top-shelf": {
      "include": ["Sources/ContextPanelTVTopShelf/**/*.swift"]
    },
    "shared-assets": {
      "include": ["Resources/Assets.xcassets/**/*"],
      "exclude": ["**/.DS_Store"]
    },
    "tv-assets": {
      "include": ["Resources/TVAssets.xcassets/**/*"],
      "exclude": ["**/.DS_Store"]
    },
    "mac-widget-host": {
      "include": ["Sources/ContextPanelApp/ContextPanelApp.swift"]
    },
    "refresh-agent-host": {
      "include": ["Sources/ContextPanelApp/RefreshAgentRegistration.swift"]
    },
    "companion-widget-host": {
      "include": [
        "Sources/ContextPanelCompanion/ContextPanelCompanionApp.swift"
      ]
    },
    "watch-widget-host": {
      "include": ["Sources/ContextPanelWatch/ContextPanelWatchApp.swift"]
    },
    "tv-top-shelf-host": {
      "include": [
        "Sources/ContextPanelTV/ContextPanelTVApp.swift",
        "Sources/ContextPanelTV/TVSystemSurfaces.swift"
      ]
    },
    "config-macos-app": {
      "include": [
        "Config/ContextPanel-Info.plist",
        "Config/ContextPanel.entitlements",
        "Config/ContextPanelAppStore.entitlements"
      ]
    },
    "config-macos-widget": {
      "include": [
        "Config/ContextPanelWidget-Info.plist",
        "Config/ContextPanelWidget.entitlements"
      ]
    },
    "config-refresh-agent": {
